# ResQAI Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
DATABASE_URL=sqlite:///resqai.db

# Official OpenAI Python SDK Integration
# Leave empty to automatically use the built-in deterministic rule-based emergency triage fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Alternative: Google Gemini API
GEMINI_API_KEY=

# Optional Notification Channels (Honest reporting if not configured)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=resqai-alerts@example.com

# Optional SMS / WebPush VAPID
SMS_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
